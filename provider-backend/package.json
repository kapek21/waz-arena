{
  "name": "bos-provider-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone BattleOfSkills provider backend (HMAC). Copy per game; set PROVIDER_KEY/SHARED_SECRET in .env.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "mock:bos": "tsx src/mock-platform.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
